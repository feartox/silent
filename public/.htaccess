<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Force HTTPS and WWW
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^silentguardacousticspro\.com [NC]
  RewriteRule ^(.*)$ https://www.silentguardacousticspro.com/$1 [L,R=301]

  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
